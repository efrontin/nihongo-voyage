{
  "name": "nihongo-voyage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href /nihongo-voyage/ && cp dist/nihongo-voyage/browser/index.html dist/nihongo-voyage/browser/404.html",
    "test:srs": "npx tsx src/app/core/srs.spec.ts",
    "test:import": "npx tsx src/app/core/import.spec.ts",
    "test": "npm run test:srs && npm run test:import"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "typescript": "~6.0.3"
  }
}
